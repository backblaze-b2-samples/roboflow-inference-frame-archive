# Backblaze B2 (S3-compatible API) — the ONLY required keys.
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your-bucket-name
# Region only — the S3 endpoint is derived from it (no region literal in source).
B2_REGION=your_b2_region

# Example of what filled-in values look like (placeholders — not real credentials):
# B2_APPLICATION_KEY_ID=<key ID from the B2 dashboard>
# B2_APPLICATION_KEY=<application key, shown once at creation>
# B2_BUCKET_NAME=my-frame-archive
# B2_REGION=us-west-004

# Optional: public base URL for objects (only if the bucket is public).
# B2_PUBLIC_URL_BASE=https://f004.backblazeb2.com/file/my-frame-archive

# Roboflow Inference — OPTIONAL, free-tier, NOT required.
# Detection runs 100% on-device. Some `inference` builds fetch pretrained weights
# from the Roboflow hub on first load and want a free key for that download only.
# Sign up: https://app.roboflow.com/settings/api
# ROBOFLOW_API_KEY=your_roboflow_api_key

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev; set
# to the deployed API origin in production (Next.js inlines it at build time).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
